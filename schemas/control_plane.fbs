include "node.fbs";

namespace Aaron.ControlPlane;

enum RaftRole : uint8 {
  Leader = 0,
  Candidate = 1,
  Follower = 2,
  Learner = 3
}

table NodeEndpoint {
  uuid: Aaron.Node.Uuid;
  addr: string;
}

table VoteRequest {
  term: uint64;
  candidate_id: Aaron.Node.Uuid;
  last_log_term: uint64;
  last_log_index: uint64;
}

table VoteResponse {
  term: uint64;
  vote_granted: bool;
  last_log_term: uint64;
  last_log_index: uint64;
  voted_for: Aaron.Node.Uuid;
}

table LogEntry {
  term: uint64;
  index: uint64;
  entry_type: uint8;
  payload: [ubyte];
}

table AppendEntriesRequest {
  term: uint64;
  leader_id: Aaron.Node.Uuid;
  prev_log_term: uint64;
  prev_log_index: uint64;
  entries: [LogEntry];
  leader_commit: uint64;
}

table AppendEntriesResponse {
  term: uint64;
  success: bool;
  last_log_term: uint64;
  last_log_index: uint64;
  conflict_term: uint64;
  conflict_index: uint64;
  voted_for: Aaron.Node.Uuid;
}

table InstallSnapshotRequest {
  term: uint64;
  leader_id: Aaron.Node.Uuid;
  last_included_term: uint64;
  last_included_index: uint64;
  offset: uint64;
  data: [ubyte];
  done: bool;
}

table InstallSnapshotResponse {
  term: uint64;
  success: bool;
  voted_for: Aaron.Node.Uuid;
}

table KeyValueCommand {
  op_type: uint8; // 0 = Set, 1 = Delete
  key: string;
  value: [ubyte];
}

table KeyValueResponse {
  success: bool;
  value: [ubyte];
}

table ShardCommand {
  shard_id: uint32;
  role: uint8; // 0 = Primary/Leader, 1 = Replica/Voter, 2 = Learner
  primary: Aaron.Node.Uuid;
  replicas: [Aaron.Node.Uuid];
  epoch: uint64;
  op_type: uint8; // 0 = AssignGroup, 1 = Promote, 2 = Demote, 3 = Leave
  target_role: uint8; // 0 = Learner, 1 = Voter, 2 = Leader
}

table ShardCommandResponse {
  success: bool;
  shard_id: uint32;
  current_role: uint8; // 0 = Learner, 1 = Voter, 2 = Leader
  term: uint64;
  reject_reason: uint8; // 0 = None, 1 = StaleEpoch, 2 = StaleTerm, 3 = NotAMember, 4 = Busy
}

table TelemetryHeartbeat {
  node_id: Aaron.Node.Uuid;
  current_wps: uint32;
  error_rate: uint32;
  timestamp: uint64;
}

table TelemetryHeartbeatResponse {
  acknowledged: bool;
}

union ControlPlanePayload {
  VoteRequest,
  VoteResponse,
  AppendEntriesRequest,
  AppendEntriesResponse,
  InstallSnapshotRequest,
  InstallSnapshotResponse,
  KeyValueCommand,
  KeyValueResponse,
  ShardCommand,
  ShardCommandResponse,
  TelemetryHeartbeat,
  TelemetryHeartbeatResponse
}

table ControlPlaneMessage {
  payload: ControlPlanePayload;
}

root_type ControlPlaneMessage;

// ----------------------------------------------------------------------------
// Persistent Storage Schemas (On-Disk Format)
// ----------------------------------------------------------------------------

table StoredVote {
  term: uint64;
  node_id: uint64;
  is_committed: bool;
}

table StoredLogId {
  term: uint64;
  index: uint64;
}

table StoredMembership {
  log_id: StoredLogId;
  voter_ids: [uint64];
  nodes: [NodeEndpoint];
}

table StoredLogEntry {
  term: uint64;
  index: uint64;
  entry_type: uint8; // 0 = Blank, 1 = Normal, 2 = Membership
  normal_op: uint8;   // 0 = Set, 1 = Delete
  normal_key: string;
  normal_value: [ubyte];
  membership: StoredMembership;
}
