include "node.fbs";

namespace Aaron.Membership;

enum MemberStatus : uint8 {
  Alive = 0,
  Suspect = 1,
  Dead = 2,
  Left = 3
}

table MemberRecord {
  node_id: Aaron.Node.NodeId;
  addr: string;
  status: MemberStatus;
  incarnation: uint64;
  tags: [string];
}

table Ping {
  seq: uint64;
  sender: MemberRecord;
  gossip: [MemberRecord];
}

table Ack {
  seq: uint64;
  sender: MemberRecord;
  gossip: [MemberRecord];
}

table PingReq {
  seq: uint64;
  target: MemberRecord;
  sender: MemberRecord;
  gossip: [MemberRecord];
}

table JoinRequest {
  sender: MemberRecord;
}

table JoinResponse {
  cluster_id: Aaron.Node.Uuid;
  members: [MemberRecord];
}

table ConfigUpdate {
  tracing_filter: string;
  probe_interval_ms: uint64;
  probe_timeout_ms: uint64;
  suspect_timeout_ms: uint64;
  indirect_ping_targets: uint32;
  gossip_fanout: uint32;
  env_key: string;
  env_val: string;
  sender: MemberRecord;
}

table ConfigAck {
  success: bool;
  sender: MemberRecord;
}

union MessagePayload {
  Ping,
  Ack,
  PingReq,
  JoinRequest,
  JoinResponse,
  ConfigUpdate,
  ConfigAck
}

table MembershipMessage {
  payload: MessagePayload;
}

root_type MembershipMessage;
